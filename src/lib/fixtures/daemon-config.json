[
  {
    "id": "server_url",
    "label": "Server URL",
    "cliFlag": "--server-url",
    "envVar": "SCANOPY_SERVER_URL",
    "configFileKey": "server_url",
    "default": "http://127.0.0.1:60072",
    "description": "URL where the daemon can reach the server",
    "docsOnly": true
  },
  {
    "id": "daemon_api_key",
    "label": "API Key",
    "cliFlag": "--daemon-api-key",
    "envVar": "SCANOPY_DAEMON_API_KEY",
    "configFileKey": "daemon_api_key",
    "default": "_Required_",
    "description": "Authentication key for daemon (generated via UI)",
    "docsOnly": true
  },
  {
    "id": "network_id",
    "label": "Network ID",
    "cliFlag": "--network-id",
    "envVar": "SCANOPY_NETWORK_ID",
    "configFileKey": "network_id",
    "default": null,
    "description": "UUID of the network to scan",
    "docsOnly": true
  },
  {
    "id": "name",
    "label": "Name",
    "cliFlag": "--name",
    "envVar": "SCANOPY_NAME",
    "configFileKey": "name",
    "default": "scanopy-daemon",
    "description": "Name for this daemon",
    "docsOnly": false
  },
  {
    "id": "mode",
    "label": "Daemon Mode",
    "cliFlag": "--mode",
    "envVar": "SCANOPY_MODE",
    "configFileKey": "mode",
    "default": "daemon_poll",
    "description": "DaemonPoll: Daemon connects to server; works behind NAT/firewall without opening ports. ServerPoll: Server connects to daemon, for deployments where daemon cannot make outbound connections - requires providing Daemon URL",
    "docsOnly": false
  },
  {
    "id": "daemon_url",
    "label": "Daemon URL",
    "cliFlag": "--daemon-url",
    "envVar": "SCANOPY_DAEMON_URL",
    "configFileKey": "daemon_url",
    "default": "_Required_",
    "description": "Base URL where server can reach daemon",
    "docsOnly": false
  },
  {
    "id": "daemon_port",
    "label": "Port",
    "cliFlag": "--daemon-port",
    "envVar": "SCANOPY_DAEMON_PORT",
    "configFileKey": "daemon_port",
    "default": "60073",
    "description": "Port the daemon listens on.",
    "docsOnly": false
  },
  {
    "id": "interfaces",
    "label": "Interfaces",
    "cliFlag": "--interfaces",
    "envVar": "SCANOPY_INTERFACES",
    "configFileKey": "interfaces",
    "default": null,
    "description": "Restrict daemon to specific network interface(s). Comma-separated for multiple (e.g., eth0,eth1). Leave empty for all interfaces",
    "docsOnly": false
  },
  {
    "id": "bind_address",
    "label": "Bind Address",
    "cliFlag": "--bind-address",
    "envVar": "SCANOPY_BIND_ADDRESS",
    "configFileKey": "bind_address",
    "default": null,
    "description": "IP address to bind daemon to",
    "docsOnly": false
  },
  {
    "id": "allow_self_signed_certs",
    "label": "Allow Self-Signed Certificates",
    "cliFlag": "--allow-self-signed-certs",
    "envVar": "SCANOPY_ALLOW_SELF_SIGNED_CERTS",
    "configFileKey": "allow_self_signed_certs",
    "default": "false",
    "description": "Allow self-signed certs for daemon -> server connections",
    "docsOnly": false
  },
  {
    "id": "accept_invalid_scan_certs",
    "label": "Accept Invalid Scan Certificates",
    "cliFlag": "--accept-invalid-scan-certs",
    "envVar": "SCANOPY_ACCEPT_INVALID_SCAN_CERTS",
    "configFileKey": "accept_invalid_scan_certs",
    "default": "true",
    "description": "Accept invalid TLS certificates when scanning endpoints. Enabled by default since scanners probe arbitrary internal services.",
    "docsOnly": false
  },
  {
    "id": "log_level",
    "label": "Log Level",
    "cliFlag": "--log-level",
    "envVar": "SCANOPY_LOG_LEVEL",
    "configFileKey": "log_level",
    "default": "info",
    "description": "Logging verbosity",
    "docsOnly": false
  },
  {
    "id": "log_file",
    "label": "Log File",
    "cliFlag": "--log-file",
    "envVar": "SCANOPY_LOG_FILE",
    "configFileKey": "log_file",
    "default": null,
    "description": "Path to log file. Defaults to platform-specific path. Set to \"none\" to disable file logging.",
    "docsOnly": false
  },
  {
    "id": "heartbeat_interval",
    "label": "Heartbeat Interval",
    "cliFlag": "--heartbeat-interval",
    "envVar": "SCANOPY_HEARTBEAT_INTERVAL",
    "configFileKey": "heartbeat_interval",
    "default": "30",
    "description": "Seconds between heartbeat updates to the server",
    "docsOnly": false
  }
