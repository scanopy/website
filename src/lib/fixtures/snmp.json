{
  "versions": [
    "SNMPv1",
    "SNMPv2c",
    "SNMPv3"
  ],
  "v3_auth_protocols": [
    "SHA-1",
    "SHA-256"
  ],
  "v3_privacy_protocols": [
    "AES-128",
    "AES-256"
  ],
  "ports": [
    161,
    1161
  ],
  "limits": [
    {
      "name": "Probe timeout",
      "value": "2s",
      "description": "Liveness probe per credential and port, used to pick a working credential before collection"
    },
    {
      "name": "Request timeout",
      "value": "5s",
      "description": "A single SNMP request"
    },
    {
      "name": "Session timeout",
      "value": "5s",
      "description": "Establishing the UDP session"
    },
    {
      "name": "Query timeout",
      "value": "1m",
      "description": "Any single query, including a full walk of a table"
    },
    {
      "name": "Max entries",
      "value": "10000",
      "description": "Rows read from a single table walk"
    },
    {
      "name": "Integration timeout",
      "value": "15m",
      "description": "A full SNMP run against one host, probe and all queries"
    }
  ],
