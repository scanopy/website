{
	"name": "scanopy-website",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"postinstall": "npm install --prefix docs",
		"dev": "vite dev",
		"dev:docs": "npm run dev --prefix docs",
		"prebuild": "node scripts/convert-changelog-images.mjs",
		"build": "vite build && npm run build --prefix docs && mkdir -p build/docs && cp -r docs/out/. build/docs/",
		"build:site": "vite build",
		"build:docs": "npm run build --prefix docs",
		"preview": "vite preview",
		"test:forms": "playwright test",
		"test:forms:headed": "playwright test --headed",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"dependencies": {
		"@iconify/svelte": "^5.1.0",
		"lucide-svelte": "^0.526.0",
		"marked": "^17.0.1",
		"posthog-js": "^1.306.0"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.10",
		"@types/node": "^26.1.1",
		"autoprefixer": "^10.4.21",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"postcss": "^8.5.6",
		"prettier": "3.6.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"sharp": "^0.35.3",
		"svelte": "^5.55.7",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^7.3.5"
	},
	"overrides": {
		"cookie": "^0.7.0"
	}
}
