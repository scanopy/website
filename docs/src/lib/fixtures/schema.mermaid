erDiagram

"users" {
  uuid id PK
  uuid organization_id FK
  text email
  text password_hash
  text oidc_provider
  text oidc_subject
  text permissions
  timestamp created_at
  timestamp updated_at
}

"organizations" {
  uuid id PK
  text name
  text stripe_customer_id
  jsonb plan
  text plan_status
  jsonb onboarding
  timestamp created_at
  timestamp updated_at
}

"networks" {
  uuid id PK
  uuid organization_id FK
  text name
  timestamp created_at
  timestamp updated_at
}

"hosts" {
  uuid id PK
  uuid network_id FK
  text name
  text hostname
  text description
  jsonb source
  jsonb virtualization
  boolean hidden
  timestamp created_at
  timestamp updated_at
}

"subnets" {
  uuid id PK
  uuid network_id FK
  text cidr
  text name
  text description
  text subnet_type
  jsonb source
  timestamp created_at
  timestamp updated_at
}

"interfaces" {
  uuid id PK
  uuid network_id FK
  uuid host_id FK
  uuid subnet_id FK
  inet ip_address
  macaddr mac_address
  text name
  integer position
  timestamp created_at
  timestamp updated_at
}

"ports" {
  uuid id PK
  uuid network_id FK
  uuid host_id FK
  integer port_number
  text protocol
  text port_type
  timestamp created_at
  timestamp updated_at
}

"services" {
  uuid id PK
  uuid network_id FK
  uuid host_id FK
  text name
  text service_definition
  jsonb virtualization
  jsonb source
  integer position
  timestamp created_at
  timestamp updated_at
}

"bindings" {
  uuid id PK
  uuid network_id FK
  uuid service_id FK
  uuid interface_id FK
  uuid port_id FK
  text binding_type
  timestamp created_at
  timestamp updated_at
}

"daemons" {
  uuid id PK
  uuid network_id FK
  uuid user_id FK
  uuid host_id
  text name
  text mode
  text url
  text version
  jsonb capabilities
  timestamp last_seen
  timestamp created_at
  timestamp updated_at
}

"api_keys" {
  uuid id PK
  uuid network_id FK
  uuid daemon_id FK
  text name
  text key
  boolean is_enabled
  timestamp last_used
  timestamp expires_at
  timestamp created_at
  timestamp updated_at
}

"discovery" {
  uuid id PK
  uuid network_id FK
  uuid daemon_id FK
  text name
  jsonb run_type
  jsonb discovery_type
  timestamp started_at
  timestamp finished_at
  timestamp created_at
  timestamp updated_at
}

"groups" {
  uuid id PK
  uuid network_id FK
  text name
  text description
  text color
  text edge_style
  text group_type
  jsonb source
  timestamp created_at
  timestamp updated_at
}

"group_bindings" {
  uuid id PK
  uuid group_id FK
  uuid binding_id FK
  integer position
  timestamp created_at
  timestamp updated_at
}

"topologies" {
  uuid id PK
  uuid network_id FK
  uuid parent_id
  text name
  jsonb nodes
  jsonb edges
  jsonb options
  jsonb hosts
  jsonb subnets
  jsonb services
  jsonb groups
  boolean is_stale
  boolean is_locked
  timestamp last_refreshed
  timestamp created_at
  timestamp updated_at
}

"shares" {
  uuid id PK
  uuid network_id FK
  uuid topology_id FK
  uuid user_id FK
  text token
  text password_hash
  boolean is_enabled
  timestamp expires_at
  timestamp created_at
  timestamp updated_at
}

"tags" {
  uuid id PK
  uuid organization_id FK
  text name
  text color
  timestamp created_at
  timestamp updated_at
}

"entity_tags" {
  uuid id PK
  uuid tag_id FK
  uuid entity_id
  text entity_type
  timestamp created_at
}

"user_network_access" {
  uuid id PK
  uuid user_id FK
  uuid network_id FK
  timestamp created_at
}

"user_api_keys" {
  uuid id PK
  uuid user_id FK
  uuid organization_id FK
  text name
  text key
  text permissions
  boolean is_enabled
  timestamp last_used
  timestamp expires_at
  timestamp created_at
  timestamp updated_at
}

"user_api_key_network_access" {
  uuid id PK
  uuid user_api_key_id FK
  uuid network_id FK
  timestamp created_at
}

"invites" {
  uuid id PK
  uuid organization_id FK
  uuid inviter_id FK
  text email
  text role
  text token
  boolean is_accepted
  timestamp expires_at
  timestamp created_at
  timestamp updated_at
}

"snmp_credentials" {
  uuid id PK
  uuid organization_id FK
  text name
  text version
  text community
  timestamp created_at
  timestamp updated_at
}

"if_entries" {
  uuid id PK
  uuid network_id FK
  uuid host_id FK
  integer if_index
  text if_descr
  integer if_type
  integer if_mtu
  bigint if_speed
  macaddr if_phys_address
  integer if_admin_status
  integer if_oper_status
  timestamp created_at
  timestamp updated_at
}

